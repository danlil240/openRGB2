# clangd configuration for openRGB2.
#
# compile_commands.json (repo root, generated by the build-clangd
# Ninja configure) already supplies the -I paths; this file only
# silences a clang-only false positive: MSVC's -fdelayed-template-
# parsing mode (forced by clang's MSVC compat driver) misreports
# nested Config{...} NSDMIs used in `= Config{}` default arguments
# (e.g. PowerLifecycle::Config::max_pending_events,
# PlaybackClockSync::Config::nominal_tick_hz). MSVC accepts the
# pattern; it is not a real defect.

Diagnostics:
  Suppress:
    - default_member_initializer_not_yet_parsed
